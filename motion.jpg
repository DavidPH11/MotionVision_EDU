<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <radialGradient id="bgGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1e3a8a"/>
      <stop offset="100%" stop-color="#020617"/>
    </radialGradient>
    <linearGradient id="cyanAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
  </defs>

  <!-- Fondo circular azul oscuro -->
  <circle cx="100" cy="100" r="90" fill="url(#bgGlow)" stroke="#38bdf8" stroke-width="3"/>

  <!-- Anillo/Órbita de movimiento -->
  <ellipse cx="100" cy="100" rx="70" ry="25" fill="none" stroke="url(#cyanAccent)" stroke-width="4" transform="rotate(-25 100 100)"/>
  
  <!-- Lente de cámara centrado -->
  <circle cx="100" cy="100" r="35" fill="#0b1329" stroke="#ffffff" stroke-width="3"/>
  <circle cx="100" cy="100" r="20" fill="url(#cyanAccent)"/>
  <circle cx="92" cy="92" r="6" fill="#ffffff" opacity="0.8"/>

  <!-- Partícula en movimiento -->
  <circle cx="155" cy="75" r="7" fill="#ffffff"/>
</svg>
